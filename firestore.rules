rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic rules for the prototype: allowing all reads/writes for app_state
    match /app_state/{document=**} {
      allow read, write: if true;
    }
    
    match /live_calls/{document=**} {
      allow read, write: if true;
    }
    match /live_calls/{callId}/signaling/{document=**} {
      allow read, write: if true;
    }
    
    match /vivlio_worlds/{document=**} {
      allow read, write: if true;
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
